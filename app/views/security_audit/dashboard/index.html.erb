<h1>Security Audit Dashboard</h1>

<table>
    <thead>
        <tr>
            <th>Library</th>
            <th>Version</th>
            <th>CVE</th>
            <th>Severity</th>
            <th>Recomendacion</th>
        </tr>
    </thead>

    <tbody>
        <% @results.each do |result| %>
            <% next if result[:vulnerabilities].empty? %>
            <tr>
                <% result[:vulnerabilities].each do |vuln| %>
                    <td><%= result[:package] %></td>
                    <td><%= result[:version] %></td>
                    <td><%= vuln["cve"]["id"] %></td>
                    <td><%= vuln["cve"]["metrics"]&.dig("cvssMetricV2",0,"baseSeverity") || "N/A" %></td>
                    <td>Upgrade to a secure version</td>
                <% end %>
            </tr>
        <% end %>
    </tbody>
</table>
